# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio injects this at runtime with the Cloud Run service URL.
# Browser Origins for TTS and WebSockets must match the request host or this URL.
# For local development, http://localhost:3000 is accepted automatically via Host.
APP_URL="MY_APP_URL"

# Set to the number of trusted reverse proxies only when deployed behind one.
# Leave at 0 when directly exposed, otherwise clients could spoof rate-limit IPs.
TRUST_PROXY=0

# Optional rate/concurrency overrides (higher defaults are used outside production):
# TTS_RATE_LIMIT_PER_IP=30
# TTS_MAX_CONCURRENCY=6
# LIVE_RATE_LIMIT_PER_IP=12
# MP_RATE_LIMIT_PER_IP=20
