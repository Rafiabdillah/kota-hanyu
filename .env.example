# GEMINI_API_KEY: Required for Gemini TTS and Live.
# Local: copy this file to .env and set your key. Never commit .env.
# Cloudflare: run `npx wrangler secret put GEMINI_API_KEY` instead.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL for the Express server behind a reverse proxy.
# Browser Origins must match the request host or this URL.
# Local development accepts http://localhost:3000 automatically via Host.
APP_URL="MY_APP_URL"

# Set to the number of trusted reverse proxies only when deployed behind one.
# Leave at 0 when directly exposed, otherwise clients could spoof rate-limit IPs.
TRUST_PROXY=0

# Optional rate/concurrency overrides (higher defaults are used outside production):
# TTS_RATE_LIMIT_PER_IP=30
# TTS_MAX_CONCURRENCY=6
# LIVE_RATE_LIMIT_PER_IP=4
# MP_RATE_LIMIT_PER_IP=20
